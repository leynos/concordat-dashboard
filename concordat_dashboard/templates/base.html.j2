<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{% endblock %}</title>
  <meta name="description" content="Every active repository swept against every functioning concordat rule.">
  <link rel="stylesheet" href="{{ page.root }}coupon.css">
</head>
<body class="bg-paper font-print text-[15px] text-ink antialiased">
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:bg-paper focus:p-2">Skip to the content</a>
<div class="mx-auto max-w-[1280px] border-x-4 border-double border-ink/60 px-2 pb-6 sm:px-4">
  <main id="main">
  {% block content %}{% endblock %}
  </main>
  <footer class="mt-4 border-t-2 border-ink pt-1 text-[11px] uppercase tracking-wide">
    Generated by <a class="underline" href="{{ page.source_url }}">{{ page.source_name }}</a>
    · Rules: concordat {{ page.concordat_version }} @ <code>{{ page.concordat_commit[:12] }}</code>
    · Swept <time datetime="{{ page.generated_iso }}">{{ page.generated_iso }}</time>
    · Not an official concordat publication
  </footer>
</div>
</body>
</html>
