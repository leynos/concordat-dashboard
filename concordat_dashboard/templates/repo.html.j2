{% extends "base.html.j2" %}
{% block title %}{{ repo.name }}: concordat findings{% endblock %}
{% block content %}
  <header class="border-b-4 border-double border-ink pt-3 pb-2">
    <p class="text-[13px] font-bold uppercase tracking-wide"><a href="../index.html" class="underline">&larr; Copy coupon</a></p>
    <h1 class="font-black leading-none tracking-tight text-print-red text-[2.6rem]">{{ repo.name }}</h1>
    <p class="mt-1 text-[14px]">
      <a class="underline" href="{{ repo.url }}">{{ repo.url }}</a>
      · at <a class="font-mono text-[12px] underline" href="{{ repo.commit_url }}">{{ repo.sha[:12] }}</a>
    </p>
  </header>
  <ol class="mt-3 space-y-2">
    {% for entry in repo.entries %}
    <li id="{{ entry.rule_id }}" class="scroll-mt-4 border border-rule p-2 target:bg-paper-deep">
      <h2 class="flex flex-wrap items-baseline gap-x-3 text-[16px] font-black">
        <span>{{ entry.rule_id }}</span>
        <span class="text-[14px] font-bold {{ 'text-print-red' if entry.state == 'noncompliant' else ('text-pencil' if entry.state in ('indeterminate', 'exempt') else 'text-ink/70') }}">{{ entry.label }}</span>
        <span class="text-[13px] font-normal text-ink/70">{{ entry.name }}</span>
      </h2>
      {% for heading, lines in [('Findings', entry.breaches), ('Not proven', entry.unproven), ('Exemption on record', entry.exemptions)] %}
      {% if lines %}
      <h3 class="mt-1 text-[12px] font-bold uppercase tracking-wide">{{ heading }}</h3>
      <ul class="ml-4 list-disc text-[14px] [overflow-wrap:anywhere]">
        {% for line in lines %}
        <li>{% if line.code %}<code class="font-mono text-[12px] font-bold">{{ line.code }}</code> {% endif %}{% if line.location %}<code class="font-mono text-[12px]">{{ line.location }}</code>: {% endif %}{{ line.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endfor %}
    </li>
    {% endfor %}
  </ol>
{% endblock %}
